default_platform(:ios)

platform :ios do
  desc "Appetize.ioへシミュレータビルドをアップロードする"
  lane :release_to_appetize do
    derived_data_path = "build/DerivedData"

    # シミュレータ向けビルド（コード署名不要）
    sh(
      "xcodebuild",
      "-workspace", "../Gdisp.xcworkspace",
      "-scheme", "app2",
      "-sdk", "iphonesimulator",
      "-configuration", "Release",
      "-derivedDataPath", "../#{derived_data_path}",
      "build-for-testing",
      "CODE_SIGNING_ALLOWED=NO"
    )

    # ビルド成果物（.app）を探索
    app_path = Dir["../#{derived_data_path}/**/Release-iphonesimulator/*.app"].first
    UI.user_error!(".appが見つかりませんでした") unless app_path

    zip_path = "../#{derived_data_path}/app.zip"

    # .appをzipに圧縮
    sh("zip", "-r", zip_path, app_path)

    # Appetize APIトークンの確認
    api_token = ENV["APPETIZE_API_TOKEN"]
    UI.user_error!("APPETIZE_API_TOKEN が設定されていません") if api_token.nil? || api_token.empty?

    public_key = ENV["APPETIZE_PUBLIC_KEY"]

    # 新規作成 or 既存アプリの更新
    if public_key.nil? || public_key.empty?
      UI.message("Appetize.ioに新規アプリをアップロードします...")
      sh(
        "curl", "--http1.1",
        "-X", "POST",
        "https://api.appetize.io/v1/apps",
        "-u", "#{api_token}:",
        "-F", "file=@#{zip_path}",
        "-F", "platform=ios"
      )
    else
      UI.message("Appetize.ioの既存アプリ（#{public_key}）を更新します...")
      sh(
        "curl", "--http1.1",
        "-X", "POST",
        "https://api.appetize.io/v1/apps/#{public_key}",
        "-u", "#{api_token}:",
        "-F", "file=@#{zip_path}",
        "-F", "platform=ios"
      )
    end
  end

  desc "GitHub ActionsからTestFlightへ自動配信する"
  lane :release_to_app_store do
    
    # GitHub Secretsから環境変数を経由してAPIキーを読み込む
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
      is_key_content_base64: false
    )

    # CI環境の対話スキップ設定
    setup_ci

    # 先ほどローカルで作った証明書を「読み取り専用」で同期（超安全）
    match(
      type: "appstore", 
      readonly: true,      # クラウド上では書き換えないよう true に戻します
      api_key: api_key,
      app_identifier: "gdisp.indicate.app"
    )

    # クラウド上でのアプリビルド
    build_app(
      workspace: "Gdisp.xcworkspace", 
      scheme: "app2",
      export_method: "app-store",
      xcargs: "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='#{ENV["sigh_gdisp.indicate.app_appstore_certificate-name"]}' PROVISIONING_PROFILE_SPECIFIER='#{ENV["sigh_gdisp.indicate.app_appstore_profile-name"]}'"
    )

    # TestFlightへのアップロード
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
